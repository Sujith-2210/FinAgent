{
    "annotations": {
        "list": []
    },
    "title": "FinAgent System Overview",
    "uid": "finagent-system",
    "version": 1,
    "panels": [
        {
            "title": "Request Rate",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "rate(finagent_http_requests_total[5m])",
                    "legendFormat": "req/s"
                }
            ]
        },
        {
            "title": "Error Rate",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 0
            },
            "targets": [
                {
                    "expr": "rate(finagent_http_errors_total[5m])",
                    "legendFormat": "errors/s"
                }
            ]
        },
        {
            "title": "Avg Response Time",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, rate(finagent_http_request_duration_seconds_bucket[5m]))",
                    "legendFormat": "p50 latency"
                }
            ]
        },
        {
            "title": "Active Connections",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "targets": [
                {
                    "expr": "finagent_active_connections",
                    "legendFormat": "connections"
                }
            ]
        },
        {
            "title": "Request Rate Over Time",
            "type": "graph",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 4
            },
            "targets": [
                {
                    "expr": "rate(finagent_http_requests_total[5m])",
                    "legendFormat": "{{method}} {{endpoint}}"
                }
            ]
        },
        {
            "title": "Response Time Distribution",
            "type": "heatmap",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 4
            },
            "targets": [
                {
                    "expr": "rate(finagent_http_request_duration_seconds_bucket[5m])",
                    "legendFormat": "{{le}}"
                }
            ]
        },
        {
            "title": "Agent Invocations",
            "type": "graph",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 12
            },
            "targets": [
                {
                    "expr": "rate(finagent_agent_invocations_total[5m])",
                    "legendFormat": "{{agent_name}}"
                }
            ]
        },
        {
            "title": "Cache Hit Rate",
            "type": "gauge",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 12,
                "y": 12
            },
            "targets": [
                {
                    "expr": "finagent_cache_hits_total / (finagent_cache_hits_total + finagent_cache_misses_total)",
                    "legendFormat": "hit rate"
                }
            ],
            "options": {
                "minValue": 0,
                "maxValue": 1,
                "thresholds": {
                    "steps": [
                        {
                            "color": "red",
                            "value": 0
                        },
                        {
                            "color": "yellow",
                            "value": 0.5
                        },
                        {
                            "color": "green",
                            "value": 0.8
                        }
                    ]
                }
            }
        },
        {
            "title": "LLM Token Usage",
            "type": "graph",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 18,
                "y": 12
            },
            "targets": [
                {
                    "expr": "rate(finagent_llm_tokens_total[5m])",
                    "legendFormat": "{{model}} {{type}}"
                }
            ]
        }
    ]
}